soong_namespace {
}

// Stock camera feature tables named *.xml that are not XML; the build would
// reject them as PRODUCT_COPY_FILES. extract-files.py exposes them as
// filegroups (see tools/gen-proprietary-files.py), installed here unchecked.

prebuilt_etc {
    name: "gma_custom.xml_mt6897",
    src: "//vendor/xiaomi/degas:degas_vendor_etc_camera_mt6897_gma_custom_xml",
    filename: "gma_custom.xml",
    sub_dir: "camera/mt6897",
    vendor: true,
}

prebuilt_etc {
    name: "gma_custom.xml_mt6985",
    src: "//vendor/xiaomi/degas:degas_vendor_etc_camera_mt6985_gma_custom_xml",
    filename: "gma_custom.xml",
    sub_dir: "camera/mt6985",
    vendor: true,
}

prebuilt_etc {
    name: "gma_custom.xml_mt6989",
    src: "//vendor/xiaomi/degas:degas_vendor_etc_camera_mt6989_gma_custom_xml",
    filename: "gma_custom.xml",
    sub_dir: "camera/mt6989",
    vendor: true,
}

// VNDK v34 libraries a few stock blobs need under their own names, see
// tools/gen-vndk-v34.py. Their links to each other are renamed already.

cc_prebuilt_library_shared {
    name: "libbase-v34",
    srcs: ["prebuilt/vndk-v34/lib64/libbase-v34.so"],
    compile_multilib: "64",
    vendor: true,
    check_elf_files: false,
    strip: {
        none: true,
    },
}


cc_prebuilt_library_shared {
    name: "libcrypto-v34",
    srcs: ["prebuilt/vndk-v34/lib64/libcrypto-v34.so"],
    compile_multilib: "64",
    vendor: true,
    check_elf_files: false,
    strip: {
        none: true,
    },
}



cc_prebuilt_library_shared {
    name: "libssl-v34",
    srcs: ["prebuilt/vndk-v34/lib64/libssl-v34.so"],
    compile_multilib: "64",
    vendor: true,
    check_elf_files: false,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libstagefright_bufferqueue_helper-v34",
    srcs: ["prebuilt/vndk-v34/lib64/libstagefright_bufferqueue_helper-v34.so"],
    compile_multilib: "64",
    vendor: true,
    check_elf_files: false,
    strip: {
        none: true,
    },
}

