android_app {
    name: "DegasParts",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "SettingsLib",
    ],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
}
