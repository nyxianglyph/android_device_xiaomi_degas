diff --git a/app/src/main/java/org/lineageos/aperture/ext/CaptureRequestOptionsBuilder.kt b/app/src/main/java/org/lineageos/aperture/ext/CaptureRequestOptionsBuilder.kt
index 4cff361..e9daed0 100644
--- a/app/src/main/java/org/lineageos/aperture/ext/CaptureRequestOptionsBuilder.kt
+++ b/app/src/main/java/org/lineageos/aperture/ext/CaptureRequestOptionsBuilder.kt
@@ -35,6 +35,23 @@ fun CaptureRequestOptions.Builder.setFrameRate(
     frameRate?.range?.toRange(),
 )
 
+/**
+ * MediaTek cameras stay at 30 fps whatever the target frame rate range says,
+ * unless their high frame rate mode is asked for as well.
+ */
+private val MEDIATEK_HFPS_MODE = CaptureRequest.Key(
+    "com.mediatek.streamingfeature.hfpsMode", IntArray::class.java
+)
+
+@androidx.camera.camera2.interop.ExperimentalCamera2Interop
+fun CaptureRequestOptions.Builder.setMediaTekHfpsMode(
+    supported: Boolean,
+    frameRate: FrameRate?,
+) = setOrClearCaptureRequestOption(
+    MEDIATEK_HFPS_MODE,
+    intArrayOf(1).takeIf { supported && frameRate != null && frameRate.value > 30 },
+)
+
 @androidx.camera.camera2.interop.ExperimentalCamera2Interop
 fun CaptureRequestOptions.Builder.setVideoStabilizationMode(
     videoStabilizationMode: VideoStabilizationMode?
diff --git a/app/src/main/java/org/lineageos/aperture/models/Camera.kt b/app/src/main/java/org/lineageos/aperture/models/Camera.kt
index 0847e6f..4592557 100644
--- a/app/src/main/java/org/lineageos/aperture/models/Camera.kt
+++ b/app/src/main/java/org/lineageos/aperture/models/Camera.kt
@@ -56,6 +56,17 @@ class Camera private constructor(
      */
     val cameraId: String = camera2CameraInfo.cameraId
 
+    /**
+     * Whether this is a MediaTek camera with a high frame rate mode.
+     */
+    val supportsMediaTekHfpsMode = runCatching {
+        camera2CameraInfo.getCameraCharacteristic(
+            CameraCharacteristics.Key(
+                "com.mediatek.streamingfeature.availableHfpsModes", IntArray::class.java
+            )
+        )?.contains(1)
+    }.getOrNull() == true
+
     /**
      * The [CameraFacing] of this camera.
      */
diff --git a/app/src/main/java/org/lineageos/aperture/repositories/CameraRepository.kt b/app/src/main/java/org/lineageos/aperture/repositories/CameraRepository.kt
index e47ac48..e8a6e05 100644
--- a/app/src/main/java/org/lineageos/aperture/repositories/CameraRepository.kt
+++ b/app/src/main/java/org/lineageos/aperture/repositories/CameraRepository.kt
@@ -62,16 +62,14 @@ class CameraRepository(
             .mapToCamera()
     }
 
-    val mainBackCamera by lazy {
-        internalCameras.firstOrNull { camera ->
-            camera.cameraFacing == CameraFacing.BACK
-        }
-    }
+    val mainBackCamera by lazy { mainCamera(CameraFacing.BACK) }
 
-    val mainFrontCamera by lazy {
-        internalCameras.firstOrNull { camera ->
-            camera.cameraFacing == CameraFacing.FRONT
-        }
+    val mainFrontCamera by lazy { mainCamera(CameraFacing.FRONT) }
+
+    private fun mainCamera(cameraFacing: CameraFacing) = internalCameras.firstOrNull { camera ->
+        camera.cameraFacing == cameraFacing && camera.cameraId in overlaysRepository.mainCameraIds
+    } ?: internalCameras.firstOrNull { camera ->
+        camera.cameraFacing == cameraFacing
     }
 
     /**
@@ -116,7 +114,7 @@ class CameraRepository(
         val camera2CameraInfo = Camera2CameraInfo.from(this)
 
         return when (camera2CameraInfo.cameraId) {
-            in mainCameraIds -> true
+            in overlaysRepository.mainCameraIds -> true
 
             else -> {
                 val isIgnoredAuxCamera = overlaysRepository.ignoredAuxCameraIds.contains(
@@ -144,13 +142,5 @@ class CameraRepository(
         context.permissionGranted(Manifest.permission.CAMERA)
     ) { "Camera permission not granted" }
 
-    companion object {
-        /**
-         * List of main camera IDs. These should never be excluded.
-         */
-        private val mainCameraIds = setOf(
-            "0",
-            "1",
-        )
-    }
+    companion object {    }
 }
