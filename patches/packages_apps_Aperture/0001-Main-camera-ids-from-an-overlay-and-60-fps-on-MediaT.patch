@@ -4,6 +4,16 @@
      SPDX-License-Identifier: Apache-2.0
 -->
 <resources>
+    <!-- IDs of the main camera of each side: the camera the app opens for that
+         side, and one that is never left out. Every other camera is an
+         auxiliary one. Change this when the first camera of a side is not the
+         one to use, for example a logical camera that cannot do what its main
+         sensor alone can. -->
+    <string-array name="config_mainCameraIds">
+        <item>0</item>
+        <item>1</item>
+    </string-array>
+
     <!-- Enable auxiliary cameras selector. -->
     <bool name="config_enableAuxCameras">false</bool>
 
