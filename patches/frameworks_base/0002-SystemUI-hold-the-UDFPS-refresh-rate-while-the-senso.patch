From: nyxianglyph <nyxianglyph@gmail.com>
Date: Tue, 24 Nov 2026 09:49:37 +0300
Subject: [PATCH 2/3] SystemUI: hold the UDFPS refresh rate while the sensor
 area is shown

A device that sets config_udfpsRefreshRate lights its sensor cleanly at
that rate only. Asking for the rate when the finger goes down is too
late for it: the sensor is lit a frame or two before the display has
switched, and the whole screen flashes for that long.

Ask for the rate as soon as the UDFPS overlay is on screen and drop the
request when it goes away, through the existing
AuthController.requestMaxRefreshRate, so that a press never comes with
a mode switch. Devices that leave the config at 0 are not affected.
---
 .../systemui/biometrics/UdfpsController.java  | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsController.java b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsController.java
index 80a815505..c0f88a6ab 100644
--- a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsController.java
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsController.java
@@ -53,6 +53,7 @@ import android.os.CancellationSignal;
 import android.os.Handler;
 import android.os.Looper;
 import android.os.PowerManager;
+import android.os.RemoteException;
 import android.os.Trace;
 import android.os.VibrationAttributes;
 import android.os.VibrationEffect;
@@ -228,6 +229,11 @@ public class UdfpsController implements DozeReceiver, Dumpable {
     // The current request from FingerprintService. Null if no current request.
     @Nullable UdfpsControllerOverlay mOverlay;
 
+    // Whether the display stays at the UDFPS refresh rate for as long as the overlay is shown,
+    // and whether that is requested right now.
+    private final boolean mHoldRefreshRate;
+    private boolean mHoldingRefreshRate;
+
     // The fingerprint AOD trigger doesn't provide an ACTION_UP/ACTION_CANCEL event to tell us when
     // to turn off high brightness mode. To get around this limitation, the state of the AOD
     // interrupt is being tracked and a timeout is used as a last resort to turn off high brightness
@@ -853,6 +859,8 @@ public class UdfpsController implements DozeReceiver, Dumpable {
         mDumpManager.registerDumpable(TAG, this);
         
         mAuthController = authController;
+        mHoldRefreshRate = mContext.getResources()
+                .getInteger(R.integer.config_udfpsRefreshRate) > 0;
 
         mOrientationListener = new BiometricDisplayListener(
                 context,
@@ -1003,6 +1011,7 @@ public class UdfpsController implements DozeReceiver, Dumpable {
             mOnFingerDown = false;
             mAttemptedToDismissKeyguard = false;
             mOrientationListener.enable();
+            holdRefreshRate(true);
             if (mFingerprintManager != null) {
                 mFingerprintManager.onUdfpsUiEvent(FingerprintManager.UDFPS_UI_OVERLAY_SHOWN,
                         overlay.getRequestId(), mSensorProps.sensorId);
@@ -1036,6 +1045,7 @@ public class UdfpsController implements DozeReceiver, Dumpable {
             }
 
             final boolean removed = mOverlay.hide();
+            holdRefreshRate(false);
             mKeyguardViewManager.hideAlternateBouncer(
                     /* updateScrim */ true,
                     /* clearDismissAction */ false
@@ -1055,6 +1065,23 @@ public class UdfpsController implements DozeReceiver, Dumpable {
         mOrientationListener.disable();
     }
 
+    /**
+     * A device that names a refresh rate for UDFPS wants the display to be at it before the
+     * sensor is lit, not to switch to it while the finger goes down. Ask for it as soon as the
+     * sensor area is on screen.
+     */
+    private void holdRefreshRate(boolean hold) {
+        if (!mHoldRefreshRate || hold == mHoldingRefreshRate) {
+            return;
+        }
+        mHoldingRefreshRate = hold;
+        try {
+            mAuthController.requestMaxRefreshRate(hold);
+        } catch (RemoteException e) {
+            Log.e(TAG, "holdRefreshRate | request failed", e);
+        }
+    }
+
     private void unconfigureDisplay(View view) {
         if (!isOptical() || !(view instanceof UdfpsTouchOverlay udfpsView)) {
             return;
