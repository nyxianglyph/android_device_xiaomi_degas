# GPU frequency scaling. MediaTek's GED driver scales the GPU on the frame
# timing that the BufferQueue of MediaTek's own framework reports to it. AOSP
# reports nothing, and the GPU then stays at its lowest frequency (265 MHz)
# at any load. In timer based mode GED scales on the GPU load instead. The
# setting survives display off; it is written twice because the module is
# loaded while init is already past early boot.
on boot
    write /sys/module/ged/parameters/g_gpu_timer_based_emu 1

on property:sys.boot_completed=1
    write /sys/module/ged/parameters/g_gpu_timer_based_emu 1
    start vendor.thermal_scenario

# See thermal-scenario.sh.
service vendor.thermal_scenario /vendor/bin/thermal-scenario.sh
    class late_start
    user system
    group system
    disabled

# The audio service is built from hardware/mediatek. The stock audio HAL it
# hosts expects what the stock service definition gave it on top of that: its
# data directories, the socket of Xiaomi's audio additions and sdcard_rw.
on post-fs-data
    mkdir /data/vendor/audiohal 0771 system audio
    mkdir /data/vendor/audio 0771 system audio

service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service.mediatek
    override
    class hal
    user audioserver
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct wakelock context_hub system sdcard_rw
    capabilities BLOCK_SUSPEND SYS_NICE
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    socket audio_hw_socket seqpacket 0666 system system
    onrestart restart audioserver

# A2DP offload stays silent (see props/vendor.prop). A value stored by an
# older build or set by hand would win over the build default, so it is
# forced off here.
on property:persist.bluetooth.a2dp_offload.disabled=false
    setprop persist.bluetooth.a2dp_offload.disabled true
