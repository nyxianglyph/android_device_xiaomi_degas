<resources>

    <!-- Display: 1220x2712 AMOLED with 60, 90, 120 and 144 Hz modes. Without
         these the framework votes for at most 60 Hz. 0 as the default rate
         means no cap below the peak. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <integer name="config_defaultPeakRefreshRate">144</integer>

    <!-- Punch hole camera, centered at the top: 60 px wide, as tall as the
         status bar (the stock HyperOS cutout). This is the area to keep
         clear, not the shape of the hole, so it must not be painted black. -->
    <string translatable="false" name="config_mainBuiltInDisplayCutout">M 0,0 H -30 V 138 H 30 V 0 H 0 Z</string>
    <bool name="config_fillMainBuiltInDisplayCutout">false</bool>

    <!-- Brightness range of the panel (stock values). -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.00238066</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.4</item>
    <integer name="config_screenBrightnessDoze">5</integer>

    <!-- Ambient light sensor and the stock auto brightness curve (lux to
         backlight). -->
    <bool name="config_automatic_brightness_available">true</bool>
    <string name="config_displayLightSensorType" translatable="false">android.sensor.light</string>
    <integer-array name="config_autoBrightnessLevels">
        <item>128</item>
        <item>256</item>
        <item>384</item>
        <item>512</item>
        <item>640</item>
        <item>768</item>
        <item>896</item>
        <item>1024</item>
        <item>2048</item>
        <item>4096</item>
        <item>6144</item>
        <item>8192</item>
        <item>10240</item>
        <item>12288</item>
        <item>14336</item>
        <item>16384</item>
        <item>18432</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>8</item>
        <item>64</item>
        <item>98</item>
        <item>104</item>
        <item>110</item>
        <item>116</item>
        <item>122</item>
        <item>128</item>
        <item>134</item>
        <item>182</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
    </integer-array>

    <!-- Power: the stock settings of the MediaTek platform. -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
    <bool name="config_suspendWhenScreenOffDueToProximity">true</bool>

    <!-- No hardware navigation keys. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Two physical SIM slots. -->
    <integer name="config_num_physical_slots">2</integer>

    <!-- Camera and microphone privacy toggles work. -->
    <bool name="config_supportsCamToggle">true</bool>
    <bool name="config_supportsMicToggle">true</bool>

    <bool name="config_enableWifiDisplay">true</bool>

    <!-- The panel lights the fingerprint sensor without disturbing the rest
         of the picture at 120 Hz only: at 60 and 144 Hz the whole screen
         brightens by almost half while the spot is on. The framework locks
         the display to its highest rate, 144 Hz, for a press unless told
         otherwise (patches/frameworks_base adds this setting). -->
    <integer name="config_udfpsRefreshRate">120</integer>

</resources>
