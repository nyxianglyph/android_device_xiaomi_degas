// In /product, like hardware/mediatek's MssiCarrierConfigOverlay whose
// vendor.xml this one replaces: overlays of a later partition win over
// /vendor ones whatever their priority.
runtime_resource_overlay {
    name: "DegasCarrierConfigOverlay",
    product_specific: true,
    aaptflags: ["--keep-raw-values"],
}
