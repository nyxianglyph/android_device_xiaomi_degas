<resources>

    <!-- The panel has more than one refresh rate: offer the smooth display
         and peak refresh rate settings. -->
    <bool name="config_show_smooth_display">true</bool>
    <bool name="config_show_peak_refresh_rate_switch">true</bool>

    <!-- Fingerprint enrollment: how far the progress ring stands off the
         sensor area, in pixels. The sensor (radius 105 px) is centred 268 px
         above the bottom edge; with the default of 280 the ring runs off the
         screen. -->
    <integer name="config_udfpsEnrollProgressBar">120</integer>

    <!-- Names of the color modes in config_availableColorModes of the
         framework overlay, in the same order. -->
    <string-array name="config_color_mode_options_strings" translatable="false">
        <item>Vivid</item>
        <item>Saturated</item>
        <item>Original color</item>
    </string-array>
    <integer-array name="config_color_mode_options_values" translatable="false">
        <item>258</item>
        <item>256</item>
        <item>257</item>
    </integer-array>

</resources>
