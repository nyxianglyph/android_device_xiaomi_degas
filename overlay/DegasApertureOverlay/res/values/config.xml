<resources>
    <!-- Camera 0 is the main and ultra-wide sensors behind one logical
         device. It cannot record above 30 fps and has no telephoto in it, so
         the main sensor alone (6) is the main back camera, and the ultra-wide
         (3) and the telephoto (2) are lenses of their own. The logical
         cameras 0, 4 and 5 are left out by config_ignoreLogicalAuxCameras. -->
    <string-array name="config_mainCameraIds">
        <item>6</item>
        <item>1</item>
    </string-array>
    <bool name="config_enableAuxCameras">true</bool>

    <!-- 1080p at 60 fps, measured on the main, telephoto and front cameras
         in MediaTek's high frame rate mode. The ultra-wide stays at 30. -->
    <string-array name="config_additionalVideoConfigurations">
        <item>6</item> <item>fhd</item> <item>60</item>
        <item>2</item> <item>fhd</item> <item>60</item>
        <item>1</item> <item>fhd</item> <item>60</item>
    </string-array>
</resources>
